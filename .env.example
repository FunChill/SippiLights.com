VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never prefix with VITE_ (that would ship it to the browser).
# From Supabase Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe test mode keys (Dashboard -> Developers -> API keys, Test mode).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
# From Stripe CLI (`stripe listen`) locally, or the Dashboard webhook endpoint once deployed.
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` — set
# this to any random string in Vercel's env vars to match.
CRON_SECRET=change-me
